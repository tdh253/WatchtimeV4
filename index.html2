<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="mobile-web-app-capable" content="yes" />
<title>Watch Time</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap');
  :root {
    --bg: #15120F; --card: #1E1A15; --cardAlt: #241F19;
    --gold: #E4B14C; --goldDim: #8A6E33; --velvet: #8C2F2F;
    --cream: #F3ECDF; --muted: #9C9184; --line: #332C22;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--cream); font-family: Georgia, serif; overflow-x: hidden; width: 100%; max-width: 100%; }
  html { -webkit-text-size-adjust: 100%; }
  img, input, button { max-width: 100%; }
  .marquee { font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.06em; }
  .serif { font-family: 'Libre Caslon Text', serif; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 0 20px; width: 100%; box-sizing: border-box; }
  .sprockets { display: flex; justify-content: space-between; padding: 6px 12px; background: var(--velvet); }
  .sprockets span { width: 10px; height: 10px; border-radius: 50%; background: var(--bg); margin: 6px 0; }
  header { border-bottom: 1px solid var(--line); }
  .header-inner { padding: 32px 0 28px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; }
  .eyebrow { display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--gold); margin-bottom: 4px; }
  h1.title { font-size: 56px; margin: 0; }
  .total-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); text-align: center; margin-top: 6px; }
  .total-value { font-size: 40px; color: var(--gold); text-align: center; }
  main { padding: 24px 0 60px; }
  .panel { background: var(--card); border: 1px solid var(--line); border-radius: 12px; margin-bottom: 24px; overflow: hidden; }
  .panel-header { padding: 12px 20px; font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gold); display: flex; align-items: center; justify-content: space-between; width: 100%; background: none; border: none; cursor: pointer; text-align: left; }
  .panel-body { padding: 0 20px 20px; border-top: 1px dashed var(--line); }
  .panel-body p { color: var(--muted); font-family: 'Libre Caslon Text', serif; font-size: 14px; padding-top: 12px; }
  .upload-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; border: 1px dashed var(--goldDim); border-radius: 12px; color: var(--gold); font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 32px; min-width: 0; }
  @media (min-width: 900px) { .grid { grid-template-columns: 2fr 3fr; } }
  .grid > div { min-width: 0; }
  .card-title { font-size: 24px; color: var(--gold); margin: 0; padding: 16px 20px; border-bottom: 1px dashed var(--line); }
  .form-body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .toggle-row { display: flex; gap: 8px; }
  .toggle-btn { flex: 1; padding: 10px; border-radius: 12px; font-family: 'Libre Caslon Text', serif; font-size: 14px; cursor: pointer; background: transparent; color: var(--muted); border: 1px solid var(--line); }
  .toggle-btn.active { background: var(--gold); color: var(--bg); border-color: var(--gold); }
  .toggle-btn.small.active { background: var(--goldDim); color: var(--cream); border-color: var(--goldDim); }
  label.field-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); display: block; margin-bottom: 4px; }
  input[type=text], input[type=number], input[type=date] {
    width: 100%; padding: 9px 12px; border-radius: 12px; background: var(--cardAlt); color: var(--cream);
    border: 1px solid var(--line); font-family: 'Libre Caslon Text', serif; font-size: 15px;
  }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .title-row { display: flex; gap: 8px; }
  .find-btn { flex-shrink: 0; display: flex; align-items: center; gap: 6px; padding: 9px 12px; border-radius: 12px; background: transparent; color: var(--gold); border: 1px solid var(--goldDim); font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; cursor: pointer; }
  .hint { font-family: 'IBM Plex Mono', monospace; font-size: 11px; margin-top: 4px; }
  .hint.good { color: var(--gold); }
  .hint.muted { color: var(--muted); }
  .hint.bad { color: #D9756B; }
  .computed-box { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-radius: 12px; background: var(--cardAlt); border: 1px solid var(--goldDim); }
  .add-btn { width: 100%; padding: 11px; border-radius: 12px; background: var(--velvet); color: var(--cream); border: none; font-family: 'Bebas Neue', sans-serif; font-size: 18px; letter-spacing: 0.04em; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .stats-panel { padding: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .stat-label { display: flex; align-items: center; gap: 6px; color: var(--muted); font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; }
  .stat-value { font-family: 'Bebas Neue', sans-serif; font-size: 26px; margin-top: 2px; }
  .stat-sub { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--muted); }
  .section-title { display: flex; align-items: center; gap: 8px; color: var(--gold); margin-bottom: 12px; }
  .section-title h3 { font-family: 'Bebas Neue', sans-serif; font-size: 20px; margin: 0; letter-spacing: 0.04em; }
  .empty-box { padding: 24px; text-align: center; background: var(--card); border: 1px dashed var(--line); border-radius: 12px; color: var(--muted); font-family: 'Libre Caslon Text', serif; font-size: 14px; }
  .poster-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 14px; }
  .poster-card { position: relative; border-radius: 16px; overflow: hidden; background: var(--cardAlt); border: 1px solid var(--line); }
  .poster-card .poster-img-wrap { width: 100%; aspect-ratio: 2 / 3; background: var(--cardAlt); display: flex; align-items: center; justify-content: center; font-size: 38px; overflow: hidden; }
  .poster-card .poster-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .poster-card .poster-info { padding: 8px 9px 10px; }
  .poster-card .poster-title { font-family: 'Libre Caslon Text', serif; font-size: 13px; color: var(--cream); line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
  .poster-card .poster-duration { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--gold); margin-top: 4px; }
  .poster-card .poster-delete { position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border-radius: 50%; background: rgba(21,18,15,0.75); border: none; color: var(--cream); font-size: 12px; display: flex; align-items: center; justify-content: center; z-index: 2; }
  .poster-card .poster-rating { position: absolute; bottom: 44px; right: 6px; width: 30px; height: 30px; border-radius: 50%; border: none; padding: 3px; z-index: 2; cursor: pointer; }
  .poster-card .poster-rating-inner { width: 100%; height: 100%; border-radius: 50%; background: var(--bg); display: flex; align-items: center; justify-content: center; font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--cream); }
  .poster-card .poster-clickzone { position: absolute; inset: 0; cursor: pointer; background: transparent; border: none; padding: 0; }
  .modal-overlay { position: fixed; inset: 0; background: rgba(10,8,6,0.82); z-index: 50; display: flex; align-items: flex-end; justify-content: center; }
  @media (min-width: 700px) { .modal-overlay { align-items: center; } }
  .modal-box { background: var(--card); border: 1px solid var(--line); border-radius: 18px 18px 0 0; width: 100%; max-width: 480px; max-height: 88vh; overflow-y: auto; padding: 20px; position: relative; }
  @media (min-width: 700px) { .modal-box { border-radius: 18px; } }
  .modal-close { position: absolute; top: 14px; right: 14px; width: 32px; height: 32px; border-radius: 50%; background: var(--cardAlt); border: none; color: var(--cream); font-size: 15px; display: flex; align-items: center; justify-content: center; }
  .modal-header { display: flex; gap: 14px; margin-bottom: 14px; padding-right: 36px; }
  .modal-poster { width: 84px; flex-shrink: 0; border-radius: 10px; overflow: hidden; aspect-ratio: 2/3; background: var(--cardAlt); display: flex; align-items: center; justify-content: center; font-size: 30px; }
  .modal-poster img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .modal-title { font-family: 'Bebas Neue', sans-serif; font-size: 24px; letter-spacing: 0.03em; color: var(--cream); line-height: 1.15; }
  .modal-meta { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--gold); margin-top: 6px; }
  .modal-overview { font-family: 'Libre Caslon Text', serif; font-size: 15px; line-height: 1.5; color: var(--cream); margin-top: 4px; }
  .cast-row { display: flex; gap: 12px; overflow-x: auto; padding: 4px 2px 8px; -webkit-overflow-scrolling: touch; }
  .cast-card { flex: 0 0 76px; text-align: center; }
  .cast-photo { width: 76px; height: 76px; border-radius: 50%; overflow: hidden; background: var(--cardAlt); display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 6px; }
  .cast-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cast-name { font-family: 'Libre Caslon Text', serif; font-size: 12px; color: var(--cream); line-height: 1.25; }
  .cast-role { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--muted); margin-top: 2px; }
  .modal-loading, .modal-empty { font-family: 'Libre Caslon Text', serif; color: var(--muted); font-size: 14px; }
  .episodes-title { font-family: 'Bebas Neue', sans-serif; font-size: 18px; color: var(--gold); letter-spacing: 0.03em; margin: 18px 0 8px; }
  .season-block { border: 1px solid var(--line); border-radius: 10px; margin-bottom: 8px; overflow: hidden; }
  .season-header { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--cardAlt); border: none; color: var(--cream); font-family: 'Libre Caslon Text', serif; font-size: 14px; cursor: pointer; }
  .season-header .season-count { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--gold); }
  .season-body { padding: 8px 12px 10px; }
  .season-actions { display: flex; gap: 8px; margin-bottom: 8px; }
  .season-actions button { flex: 1; padding: 6px; border-radius: 6px; background: transparent; border: 1px solid var(--goldDim); color: var(--gold); font-family: 'IBM Plex Mono', monospace; font-size: 10px; text-transform: uppercase; cursor: pointer; }
  .episode-row { display: flex; align-items: flex-start; gap: 10px; padding: 7px 0; border-bottom: 1px dashed var(--line); }
  .episode-row:last-child { border-bottom: none; }
  .episode-row input[type=checkbox] { margin-top: 3px; width: 17px; height: 17px; accent-color: var(--gold); flex-shrink: 0; }
  .episode-name { font-family: 'Libre Caslon Text', serif; font-size: 13.5px; color: var(--cream); line-height: 1.3; }
  .episode-meta { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: var(--muted); margin-top: 2px; }
  .delete-btn { background: none; border: none; color: var(--muted); cursor: pointer; opacity: 0.6; font-size: 15px; }
  .delete-btn:hover { opacity: 1; }
</style>
</head>
<body>
<div id="root"></div>

<script>
